# ============================================================
# 环境变量模板：复制为 .env 后按实际情况填写
# 所有配置项必须以 RAG_ 前缀命名（见 config/settings.py 的 env_prefix）
# ============================================================

# ---------- 应用基础 ----------
RAG_LOG_LEVEL=INFO
RAG_LOG_DIR=logs

# ---------- OpenAI 兼容 API ----------
# 任意 OpenAI 兼容网关均可：OpenAI / DeepSeek / 通义 / vLLM / OneAPI 等
# 本工程支持 Chat 与 Embedding 分离（见下方 Embedding 独立配置）
RAG_OPENAI_BASE_URL=https://api.deepseek.com/v1
RAG_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_CHAT_MODEL=deepseek-v4-flash
RAG_LLM_TIMEOUT=60
RAG_LLM_MAX_RETRIES=3
RAG_LLM_TEMPERATURE=0.0

# ---------- Embedding 独立配置（可选） ----------
# openai_compatible=远端兼容网关（Embedding 需该网关支持 embedding 接口）
# local_fastembed=本地 ONNX 模型（离线免费，推荐开发/国内环境；首次运行自动下载模型）
RAG_EMBEDDING_PROVIDER=local_fastembed
# 远端 embedding 与 chat 不同源时可独立指定；留空回退 RAG_OPENAI_BASE_URL / RAG_OPENAI_API_KEY
# RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# RAG_EMBEDDING_API_KEY=sk-xxx

# ---------- Qdrant ----------
# 方式一：远程服务（生产，推荐 Docker 部署，见 README）
# RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_API_KEY=
# 方式二：本地文件模式（开发/单机，不填 URL 时生效，数据落在 RAG_QDRANT_PATH）
RAG_QDRANT_PATH=./qdrant_data
RAG_COLLECTION_NAME=rag_documents
RAG_VECTOR_SIZE=1536
RAG_DISTANCE=Cosine

# ---------- 文本分块 ----------
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# ---------- 检索 ----------
RAG_TOP_K=4
# 相似度阈值（0~1），留空表示不过滤；配合 Cosine 距离使用
# RAG_SCORE_THRESHOLD=0.3

# ---------- 检索增强：混合召回 + 重排 ----------
# hybrid=向量+BM25 混合召回（推荐）；vector=纯向量
RAG_RETRIEVAL_MODE=hybrid
RAG_BM25_K=8
RAG_FUSION_K=60
# Rerank 精排：过滤低置信片段，降低幻觉；本地 ONNX 模型离线免费
RAG_ENABLE_RERANK=true
RAG_RERANK_PROVIDER=local_onnx
RAG_RERANK_MODEL=Xenova/bge-reranker-base
# 重排分阈值（sigmoid 概率 0~1），低于该值不进上下文；留空只排序不过滤
# RAG_RERANK_THRESHOLD=0.3
RAG_RERANK_BATCH_SIZE=16

# ---------- MySQL 聊天历史 / 用户会话 ----------
RAG_MYSQL_HOST=127.0.0.1
RAG_MYSQL_PORT=3306
RAG_MYSQL_USER=root
RAG_MYSQL_PASSWORD=your_mysql_password   # 必填：本机 MySQL 密码
RAG_MYSQL_DB=rag_chat                    # 数据库不存在会自动创建
RAG_MEMORY_ROUNDS=6                      # 多轮记忆保留最近几轮（0=关闭记忆）

# ---------- JWT 登录鉴权 ----------
RAG_JWT_SECRET=change-me-to-a-long-random-secret   # 生产必须改
RAG_JWT_EXPIRE_MINUTES=1440              # token 有效期（分钟）

# ---------- HTTP API ----------
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000

# ---------- Docker 部署（docker-compose 使用，本地开发可忽略） ----------
# MySQL root 密码：compose 用它初始化 mysql 容器，需与 RAG_MYSQL_PASSWORD 一致
MYSQL_ROOT_PASSWORD=your_mysql_root_password
# 前端服务通过该地址访问 API（容器内 http://api:8000/api；本地开发 http://127.0.0.1:8000/api）
# API_BASE_URL=http://127.0.0.1:8000/api
